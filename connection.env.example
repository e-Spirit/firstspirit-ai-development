# Copy this to connection.env in the root of this repository (Git ignores it), fill in the values, then:  chmod 600 connection.env
# Another place works too: set FS_CONNECTION_FILE to the full path. The scripts look there first.
# Use a DEVELOPMENT project and development credentials only. Never production.
# Single quotes around every value: a $ in a password is otherwise expanded to nothing and you get a misleading 401.
# Put a comment on its own line, never after a value: a plain KEY=VALUE reader keeps it as part of the value.
# Tell your assistant the path. Never paste the password into the chat.
# Check the file with:  scripts/check-connection.py   (prints set / empty, never a value)
FS_REST_BASE_URL='https://<your-server>/rest/v1'
FS_PROJECT_ID='<the ID of your project>'
FS_USERNAME='<your login>'
FS_PASSWORD='<your password>'
# The word "development", written by you: the check refuses anything else, and so does the assistant.
FS_STAGE='development'
